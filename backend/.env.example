# Server
PORT=4000
FRONTEND_URL=http://localhost:3100

# Auth
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_BRIDGE_SECRET=replace-with-a-long-random-secret

# Postgres (Supabase) — transaction-mode pooler for the app, session-mode for migrations
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project (service role key — server-side only, never expose to the client)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Google Gemini — generation, section adaptation, and embeddings
GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Groq — fallback text/JSON generation if Gemini's quota is exhausted (optional)
GROK_API_KEY=replace-with-groq-api-key
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Resend — password reset emails (optional in dev; falls back to logging the link)
RESEND_API=replace-with-resend-api-key
# MAIL_FROM="Cobbins AI <onboarding@resend.dev>"

# Polar — checkout/billing (optional)
POLAR_ACCESS_TOKEN=replace-with-polar-access-token
